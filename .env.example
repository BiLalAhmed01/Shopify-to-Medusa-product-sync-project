# =============================================================================
# Copy this file to `.env` and fill in real values.  NEVER commit `.env`.
#   cp .env.example .env
# =============================================================================

# ---------------------------------------------------------------------------
# SHOPIFY  (source of truth)
# ---------------------------------------------------------------------------
# Your store domain, without https:// and without a trailing slash.
SHOPIFY_SHOP=your-store.myshopify.com

# Admin API access token from a *custom app* (starts with "shpat_").
# Shopify admin -> Settings -> Apps and sales channels -> Develop apps
# Required scopes: read_products, read_inventory, read_locations
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shopify releases a new API version every quarter (YYYY-MM).
# Check https://shopify.dev/docs/api/admin-graphql and use the latest *stable* one.
SHOPIFY_API_VERSION=2026-07

# Dev only. Leave empty in production. `npm run demo` sets this to the local
# mock server so the project can be run without a real store.
SHOPIFY_API_BASE_URL=

# Only needed if you run the webhook server (npm run webhooks).
# This is the "client secret" of the custom app, used to verify webhook signatures.
SHOPIFY_WEBHOOK_SECRET=
WEBHOOK_PORT=4000

# Local web dashboard (npm run dashboard) - status, manual sync, live logs.
DASHBOARD_PORT=5050

# ---------------------------------------------------------------------------
# MEDUSA  (destination)
# ---------------------------------------------------------------------------
MEDUSA_BACKEND_URL=http://localhost:9000

# Option A (default): log in as an admin user (email + password).
MEDUSA_ADMIN_EMAIL=admin@medusa-test.com
MEDUSA_ADMIN_PASSWORD=supersecret

# Option B (recommended for servers/CI): a secret admin API key created in the
# Medusa dashboard under Settings -> Secret API Keys. If this is set it wins,
# and email/password are ignored.
MEDUSA_ADMIN_API_KEY=

# Products must belong to a sales channel to be visible in a storefront.
# Get the id from the Medusa dashboard -> Settings -> Sales Channels (sc_...).
MEDUSA_SALES_CHANNEL_ID=

# Inventory levels are stored per stock location (sloc_...).
# Medusa dashboard -> Settings -> Locations. Leave empty to skip inventory sync.
MEDUSA_STOCK_LOCATION_ID=

# Currency to write prices in. Must exist in one of your Medusa regions.
MEDUSA_CURRENCY_CODE=usd

# How Medusa expects money.  Medusa v2 = "decimal" (19.99). Medusa v1 = "cents" (1999).
MEDUSA_PRICE_FORMAT=decimal

# ---------------------------------------------------------------------------
# SYNC BEHAVIOUR
# ---------------------------------------------------------------------------
# How many Shopify products to pull per page (max 250, keep <= 50 for GraphQL cost).
SYNC_PAGE_SIZE=25

# Where the local sync state (last run time + id mapping) is stored.
SYNC_STATE_FILE=./.sync-state.json

# Map Shopify collections to Medusa categories: true | false
SYNC_CATEGORIES=true

# If a product has no Shopify collection, fall back to its "Product type": true | false
SYNC_PRODUCT_TYPE_AS_CATEGORY=true

# Sync inventory quantities: true | false
SYNC_INVENTORY=true

# debug | info | warn | error
LOG_LEVEL=info
